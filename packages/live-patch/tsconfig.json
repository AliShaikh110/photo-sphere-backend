{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Build metadata is kept out of dist/, which is published whole.
    "tsBuildInfoFile": ".tsbuildinfo",
    "lib": ["ES2022"],
    "types": [],
    // The publishable JavaScript comes from scripts/build-packages.mjs; tsc
    // owns the declarations. Maps are omitted because they would point at
    // sources the tarball does not ship.
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../experience-compiler" },
    { "path": "../experience-schema" },
    { "path": "../viewer-integration" }
  ]
}

NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sphere
DB_USER=sphere
DB_PASSWORD=sphere
DB_SSL=false
# Optional override for managed hosts that only hand out a connection string.
# When set it wins over the DB_* settings above.
# DATABASE_URL=postgres://sphere:sphere@127.0.0.1:5432/sphere
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Browser-direct access policy. Each group defaults to CORS_ORIGINS; set one
# only when the editor, the player and embedding sites live on different
# origins. No group uses credentialled CORS.
EDITOR_ORIGINS=
PLAYER_ORIGINS=
EMBED_ORIGINS=

# The short-lived, project-scoped credential a browser holds instead of the
# creator's bearer token, for media, the event stream and telemetry.
EDITOR_SESSION_TTL_SECONDS=900

# The live authoring push channel. It is an optimization: turn it off behind a
# proxy that blocks streaming and clients fall back to polling.
EVENT_STREAM_ENABLED=true
EVENT_STREAM_HEARTBEAT_MS=20000
EVENT_STREAM_MAX_PER_PROJECT=20
EVENT_STREAM_MAX_PER_USER=8
EVENT_STREAM_REPLAY_BUFFER=200

# Media references one refresh request may name.
MEDIA_TOKEN_REFRESH_MAX=200
STORAGE_ROOT=./storage
MAX_IMAGE_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=80000000
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_MS=1800000
MAX_VIDEO_DERIVATIVE_BYTES=1073741824
# auto uses ffmpeg when FFMPEG_PATH resolves, otherwise the compatibility provider
VIDEO_TRANSCODER=auto
# FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_TRANSCODE_TIMEOUT_MS=600000
VIDEO_POSTER_PLACEHOLDER_ENABLED=true
VIDEO_POSTER_TIME_MS=1000
VIDEO_DESKTOP_MAX_WIDTH=8192
VIDEO_DESKTOP_MAX_FRAME_RATE=60
VIDEO_DESKTOP_TARGET_BITRATE=16000000
# 4096 is the documented handheld ceiling for 360 video delivery
VIDEO_MOBILE_MAX_WIDTH=4096
VIDEO_MOBILE_MAX_FRAME_RATE=30
VIDEO_MOBILE_TARGET_BITRATE=6000000
VIDEO_AUDIO_BITRATE=128000
VIDEO_CODEC=h264
VIDEO_AUDIO_CODEC=aac
PANORAMA_TILING_ENABLED=true
PANORAMA_TILING_MIN_WIDTH=6144
PANORAMA_TILING_MIN_SOURCE_BYTES=12582912
PANORAMA_TILING_MIN_LEVEL_WIDTH=4096
PANORAMA_TILE_SIZE=512
PANORAMA_TILE_QUALITY=82
PANORAMA_TILE_MAX_LEVELS=4
TOUR_INLINE_MAX_SCENES=32
TOUR_INLINE_MAX_MANIFEST_BYTES=1048576
TOUR_INLINE_MAX_CONNECTIONS=128
TOUR_INLINE_MAX_AVERAGE_CONNECTIONS=5
UPLOAD_SESSION_TTL_SECONDS=3600
SIGNED_MEDIA_TTL_SECONDS=900
# Lifetime of the runtime-telemetry ingest token issued with a manifest.
# It must outlast a viewing session, since a visitor reports experience_exited
# against the token they were served at load.
TELEMETRY_TOKEN_TTL_SECONDS=21600
MEDIA_WORKER_MODE=embedded
MEDIA_WORKER_POLL_MS=1000
MEDIA_JOB_LEASE_SECONDS=900
LOG_LEVEL=info
TRUST_PROXY=false
AUTO_MIGRATE=false
VIEWER_INTEGRATION_VERSION=psv-5.14.3-adapter-2
# Viewer integration: must name a version this build can emit (see the compiler
# viewer integration registry). Rollout targets a candidate for a deterministic
# share of projects; the reference experience suite gates promotion.
VIEWER_INTEGRATION_ROLLOUT_PERCENT=0
# VIEWER_INTEGRATION_CANDIDATE_VERSION=
# Advanced ingest and live input stay off until a concrete provider is approved.
DUAL_FISHEYE_INGEST_ENABLED=false
LIVE_SOURCE_ENABLED=false
# Comma-separated hosts a pull-based live source may be fetched from.
LIVE_SOURCE_ALLOWED_HOSTS=
# Creator analytics query window ceiling, in days.
ANALYTICS_MAX_RANGE_DAYS=92
# Publish budget: an experience beyond these limits is rejected with a
# diagnosable publish failure instead of producing an unserveable manifest.
PUBLISH_MAX_SCENES=500
PUBLISH_MAX_MANIFEST_BYTES=8388608
PUBLISH_MAX_SCENE_DEFINITION_BYTES=2097152

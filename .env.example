NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sphere:sphere@127.0.0.1:5432/sphere
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
STORAGE_ROOT=./storage
MAX_IMAGE_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=80000000
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_VIDEO_DURATION_MS=1800000
MAX_VIDEO_DERIVATIVE_BYTES=1073741824
# auto uses ffmpeg when FFMPEG_PATH resolves, otherwise the compatibility provider
VIDEO_TRANSCODER=auto
# FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_TRANSCODE_TIMEOUT_MS=600000
VIDEO_POSTER_PLACEHOLDER_ENABLED=true
VIDEO_POSTER_TIME_MS=1000
VIDEO_DESKTOP_MAX_WIDTH=8192
VIDEO_DESKTOP_MAX_FRAME_RATE=60
VIDEO_DESKTOP_TARGET_BITRATE=16000000
# 4096 is the documented handheld ceiling for 360 video delivery
VIDEO_MOBILE_MAX_WIDTH=4096
VIDEO_MOBILE_MAX_FRAME_RATE=30
VIDEO_MOBILE_TARGET_BITRATE=6000000
VIDEO_AUDIO_BITRATE=128000
VIDEO_CODEC=h264
VIDEO_AUDIO_CODEC=aac
PANORAMA_TILING_ENABLED=true
PANORAMA_TILING_MIN_WIDTH=6144
PANORAMA_TILING_MIN_SOURCE_BYTES=12582912
PANORAMA_TILING_MIN_LEVEL_WIDTH=4096
PANORAMA_TILE_SIZE=512
PANORAMA_TILE_QUALITY=82
PANORAMA_TILE_MAX_LEVELS=4
TOUR_INLINE_MAX_SCENES=32
TOUR_INLINE_MAX_MANIFEST_BYTES=1048576
TOUR_INLINE_MAX_CONNECTIONS=128
TOUR_INLINE_MAX_AVERAGE_CONNECTIONS=5
UPLOAD_SESSION_TTL_SECONDS=3600
SIGNED_MEDIA_TTL_SECONDS=900
MEDIA_WORKER_MODE=embedded
MEDIA_WORKER_POLL_MS=1000
MEDIA_JOB_LEASE_SECONDS=900
LOG_LEVEL=info
TRUST_PROXY=false
AUTO_MIGRATE=false
VIEWER_INTEGRATION_VERSION=psv-5.14.3-adapter-1
